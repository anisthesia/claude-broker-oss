{
  "name": "claude-broker",
  "version": "2.1.0",
  "description": "A tiny MCP HTTP server that lets multiple Claude Code (or any MCP client) sessions exchange messages over named channels — the coordination backbone for multi-agent workflows.",
  "type": "module",
  "license": "MIT",
  "author": "rideprodev",
  "homepage": "https://github.com/rideprodev/claude-broker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rideprodev/claude-broker.git"
  },
  "bugs": {
    "url": "https://github.com/rideprodev/claude-broker/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "message-broker",
    "multi-agent",
    "agent-coordination",
    "sqlite",
    "pub-sub"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "server.js",
  "bin": {
    "claude-broker": "server.js"
  },
  "files": [
    "server.js",
    "schemas/",
    "docs/",
    ".env.example",
    "workers.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node run-tests.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  }
}
