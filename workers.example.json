[
  {
    "name": "backend",
    "ns": "team",
    "model": "claude-opus-4-7",
    "args": [
      "backend",
      "--repo-root",
      "/path/to/your/repo",
      "--inbox-channel",
      "team-backend"
    ]
  },
  {
    "name": "frontend",
    "ns": "team",
    "args": [
      "frontend",
      "--repo-root",
      "/path/to/your/repo",
      "--inbox-channel",
      "team-frontend"
    ]
  },
  {
    "name": "qa",
    "ns": "team",
    "args": [
      "qa",
      "--repo-root",
      "/path/to/your/repo",
      "--inbox-channel",
      "team-qa",
      "--patrol-interval",
      "1800",
      "--patrol-watch-channel",
      "team-status"
    ]
  }
]
