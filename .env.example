# ─────────────────────────────────────────────────────────────────────────────
# claude-broker configuration. Copy to `.env` and edit.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────

# Port the broker listens on.
PORT=8080

# Shared bearer secret. Every MCP client must send this as `Authorization: Bearer <secret>`.
# REQUIRED: the broker refuses to start without it, unless BROKER_ALLOW_NO_AUTH=1 is set.
# Generate a strong one:  openssl rand -hex 32
SHARED_SECRET=change-me-to-a-long-random-string

# Explicitly allow running with NO authentication (SHARED_SECRET unset).
# Only for local / fully trusted networks. Never set this on an exposed host.
# BROKER_ALLOW_NO_AUTH=1

# SQLite database file (created on first run, WAL mode).
DB_PATH=./broker.db

# ── Auto-prune (housekeeping) ────────────────────────────────────────────────

# How often the background pruner runs (ms). Default: 5 minutes.
# PRUNE_INTERVAL_MS=300000

# Messages older than this are auto-deleted (ms). Default: 48 hours.
# PRUNE_MAX_AGE_MS=172800000

# Comma-separated channel names NEVER auto-pruned (persistent backlogs, sprint history, and
# the shared-knowledge *-notes channel every worker reads at cold start).
# PRUNE_EXEMPT=backlog,retrospective,notes

# Compacting prune: "signal" types (the audit trail) live longer than chatter.
# Heartbeats/status/notes go at PRUNE_MAX_AGE_MS; these types at PRUNE_SIGNAL_MAX_AGE_MS.
# Default: 30 days.
# PRUNE_SIGNAL_MAX_AGE_MS=2592000000
# PRUNE_SIGNAL_TYPES=task,result,question,error,contract-change,contract-proposal,finding,decision

# On *-telemetry channels a new row from a sender evicts that sender's older rows whose
# state is in this list, so 30-second "working" heartbeats posted via POST /messages
# don't accumulate. Session-end / idle-exit rows are kept (cost history).
# HEARTBEAT_TRANSIENT_STATES=working,idle-polling

# ── Dashboard cost / rate-limit views (optional) ─────────────────────────────

# Channel the /cost view aggregates session-cost heartbeats from.
# TELEMETRY_CHANNEL=telemetry

# Channel the /rate-limits view reads rate-limit events from.
# RATE_LIMIT_CHANNEL=rate-limits

# ── Worker management (optional) ─────────────────────────────────────────────
# Only needed if you use start_worker/stop_worker to supervise agent processes.
# See docs/DEPLOYMENT.md for the watchdog contract. Leave unset to disable.

# Path to your worker-supervisor ("watchdog") executable that start_worker spawns.
# WATCHDOG_BIN=/path/to/watchdog.sh

# JSON file describing the workers (see workers.example.json).
# WORKERS_CONFIG=./workers.json

# Directory for per-worker stdout/stderr logs (subprocess mode).
# WORKERS_LOG_DIR=./worker-logs

# Seconds without a heartbeat before a worker is shown "offline" on the dashboard.
# WORKER_OFFLINE_THRESHOLD_S=300

# Variables the WATCHDOG reads (start_worker injects BROKER_URL and BROKER_SECRET into
# each watchdog it spawns; set them only when running watchdog.sh by hand).
# BROKER_URL=http://localhost:8080
# BROKER_SECRET=<same value as SHARED_SECRET>
# CLAUDE_BIN=/path/to/claude
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# tmux session name. When set, start_worker launches each worker in a named tmux
# window instead of a detached subprocess. In tmux mode the broker auto-injects
# BROKER_SECRET (= SHARED_SECRET) into the watchdog environment.
# WORKERS_TMUX_SESSION=claude-broker

# Full path to the tmux binary (needed under launchd/systemd where PATH is minimal).
# Find it with: which tmux
# TMUX_BIN=/usr/local/bin/tmux
