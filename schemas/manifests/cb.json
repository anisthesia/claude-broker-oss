{
  "ns": "cb",
  "version": "3.0",
  "strict": false,
  "closed": true,
  "plan_gate": true,
  "roles": {
    "reviewer": {
      "summary_prefixes": [
        "APPROVE",
        "ADVISE",
        "BLOCK"
      ]
    },
    "orchestrator": {
      "extensions": {
        "task": {
          "required": [
            "scope",
            "acceptance_criteria"
          ]
        }
      }
    }
  },
  "workers": [
    {
      "name": "orchestrator",
      "inbox": "cb-orchestrator",
      "role": "orchestrator"
    },
    {
      "name": "core",
      "inbox": "cb-core",
      "role": "worker"
    },
    {
      "name": "protocol-qa",
      "inbox": "cb-protocol-qa",
      "role": "worker"
    },
    {
      "name": "retro",
      "inbox": "cb-retro",
      "role": "worker"
    },
    {
      "name": "judge",
      "inbox": "cb-judge",
      "role": "worker"
    },
    {
      "name": "reviewer",
      "inbox": "cb-reviewer",
      "role": "reviewer"
    }
  ],
  "channels": [
    {
      "name": "cb-core",
      "kind": "worker-inbox",
      "types": [
        "task",
        "question",
        "note",
        "rotate",
        "plan-decision"
      ],
      "extensions": {
        "task": {
          "required": [
            "body"
          ],
          "patterns": {
            "task_id": "^cb-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+"
          },
          "properties": {
            "files": {
              "properties": {
                "read": true,
                "write": true
              },
              "additionalProperties": false
            },
            "checks": {
              "items": {
                "properties": {
                  "name": true,
                  "run": true,
                  "pass_condition": true
                },
                "additionalProperties": false
              }
            },
            "context": {
              "minLength": 1
            },
            "background": {
              "minLength": 1
            }
          }
        },
        "question": {
          "patterns": {
            "task_id": "^cb-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+"
          },
          "properties": {
            "summary": false,
            "affected_files": false
          }
        },
        "note": {
          "patterns": {
            "task_id": "^cb-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+"
          }
        },
        "rotate": {
          "patterns": {
            "task_id": "^cb-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+"
          }
        }
      }
    },
    {
