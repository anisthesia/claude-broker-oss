      "envelope": false,
      "required": [
        "type",
        "sprint",
        "dates",
        "workers",
        "tasks"
      ],
      "properties": {
        "sprint": {
          "type": "string"
        },
        "dates": {
          "type": [
            "string",
            "object"
          ]
        },
        "workers": {
          "type": [
            "array",
            "object"
          ]
        },
        "tasks": {
          "type": [
            "array",
            "object"
          ]
        },
        "key_metrics": {
          "type": "object"
        },
        "backlog_deferred": {
          "type": "array"
        }
      },
      "closed": false
    },
    "judgment": {
      "required": [
        "verdict",
        "question_ref",
        "summary"
      ],
      "properties": {
        "from": {
          "const": "judge"
        },
        "subject": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "verdict": {
          "enum": [
            "decided",
            "returned",
            "held"
          ]
        },
        "question_ref": {
          "type": "string",
          "pattern": "^ca-status#[0-9]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "basis": {
          "type": "string",
          "pattern": "^(ca-notes#[0-9]+|docs/knowledge/ca\\.md#.+|CLAUDE\\.md:.+)$"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "decided"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "basis"
            ]
          }
        }
      ]
    }
