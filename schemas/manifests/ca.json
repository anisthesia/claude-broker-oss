        },
        "summary": {
          "maxLength": 400
        },
        "outcome": {
          "enum": [
            "fixed",
            "superseded",
            "invalid",
            "expired"
          ]
        }
      }
    },
    "deferred": {
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "deferred"
              }
            }
          },
          "then": {
            "required": [
              "deferred_reason"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "const": "deferred-resolved"
              },
              "body": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "required": [
                  "resolved_in_sprint",
                  "outcome"
                ],
                "properties": {
                  "outcome": {
                    "enum": [
                      "promoted",
                      "cancelled",
                      "superseded"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
