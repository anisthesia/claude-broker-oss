{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "claude-broker/base/approval-token",
  "title": "claude-broker base approval token",
  "description": "Orchestrator-issued, time-boxed authorization for a production-touching action. Posted on <ns>-control; workers cite it as consent_basis 'approval-token:#<message id>'.",
  "version": "3.0",
  "type": "object",
  "required": [
    "type",
    "task_id",
    "from",
    "to",
    "subject"
  ],
  "properties": {
    "type": {
      "const": "approval-token"
    },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "description": "Unique task key. Namespaces constrain the format via a manifest extension (e.g. cb-YYYY-MM-DD-<slug>)."
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "description": "Sender identity (worker name, 'orchestrator', ...)."
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "description": "Addressee: a worker name, 'orchestrator', or '*' for broadcast."
    },
    "subject": {
      "type": "string",
      "minLength": 3,
      "description": "Headline, readable in the summary projection."
    },
    "body": {
      "type": "object",
      "required": [
        "authorized_actions",
        "env",
        "scope_workers",
        "expires_at"
      ],
      "properties": {
        "authorized_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "string"
        },
        "scope_workers": {
          "type": "array",
          "minItems": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "refs": {
      "type": "array",
      "description": "Message ids, task_ids, commit shas, URLs."
    }
  },
  "additionalProperties": true
}
