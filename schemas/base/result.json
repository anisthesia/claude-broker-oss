{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "claude-broker/base/result",
  "title": "claude-broker base result envelope",
  "description": "A worker's outcome for a task. summary is mandatory and starts PASS / FAIL / SKIP; the server derives task state from that prefix (get_task_ledger).",
  "version": "3.0",
  "type": "object",
  "required": [
    "type",
    "task_id",
    "from",
    "to",
    "subject",
    "summary"
  ],
  "properties": {
    "type": {
      "const": "result"
    },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "description": "Unique task key. Namespaces constrain the format via a manifest extension (e.g. cb-YYYY-MM-DD-<slug>)."
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "description": "Sender identity (worker name, 'orchestrator', ...)."
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "description": "Addressee: a worker name, 'orchestrator', or '*' for broadcast."
    },
    "subject": {
      "type": "string",
      "minLength": 3,
      "description": "Headline, readable in the summary projection."
    },
    "body": {
      "description": "Result payload.",
      "type": "object",
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sha",
              "branch"
            ],
            "properties": {
              "sha": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "consent_basis": {
          "type": "string",
          "description": "How consent was obtained, e.g. 'orchestrator-dispatch-only', 'terminal-human', 'approval-token:#<id>'. Required when production_touching is true."
        },
        "production_touching": {
          "type": "boolean"
        },
        "required_checks": {
          "type": "object"
        }
      }
    },
    "refs": {
      "type": "array",
      "description": "Message ids, task_ids, commit shas, URLs."
    },
    "summary": {
      "type": "string",
      "pattern": "^(PASS|FAIL|SKIP)\\b",
      "description": "'PASS — <what>' / 'FAIL — <what failed>' / 'SKIP — <reason>'. Namespaces may tighten the separator."
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source files touched; namespaces require it when body.commits is non-empty."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "object",
            "required": [
              "commits"
            ],
            "properties": {
              "commits": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "affected_files"
        ],
        "properties": {
          "affected_files": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "object",
            "required": [
              "production_touching"
            ],
            "properties": {
              "production_touching": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "consent_basis"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
