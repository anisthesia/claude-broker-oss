{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "postgear pg-orchestrator-inbox envelope",
  "description": "Messages sent into the postgear orchestrator inbox — escalations, questions, and notes from workers.",
  "type": "object",
  "required": [
    "type",
    "task_id",
    "from",
    "to",
    "subject"
  ],
  "properties": {
    "type": {
      "enum": [
        "question",
        "note",
        "status"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "description": "Sending worker: 'core', 'devops' or 'reviewer'."
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "description": "Should be 'orchestrator'."
    },
    "subject": {
      "type": "string",
      "minLength": 3
    },
    "body": {},
    "refs": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
